lexer grammar TeachingScriptLexer;

// ------------------------------------------------------------------ //
// Keywords
// ------------------------------------------------------------------ //
LESSON       : 'lesson';
DATASET      : 'dataset';
ADD_EXAMPLES : 'add_examples';
TEST         : 'test';
CHECKPOINT   : 'checkpoint';
ROLLBACK     : 'rollback';

// ------------------------------------------------------------------ //
// Punctuation
// ------------------------------------------------------------------ //
LBRACE   : '{';
RBRACE   : '}';
LBRACKET : '[';
RBRACKET : ']';
COMMA    : ',';
ARROW    : '->';

// ------------------------------------------------------------------ //
// Literals
// ------------------------------------------------------------------ //
STRING : '"' (~["\\\r\n] | '\\' .)* '"';
NUMBER : [0-9]+ ('.' [0-9]+)?;

// ------------------------------------------------------------------ //
// Ignored
// ------------------------------------------------------------------ //
WS           : [ \t\r\n]+ -> skip;
LINE_COMMENT : '#' ~[\r\n]* -> skip;